  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NisitSimulator.Interaction.TalkNPC
  npcName: "\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E23\u0E48\u0E27\u0E21\u0E04\u0E13\u0E30"
  lines:
  - "\u0E40\u0E2E\u0E49 \u0E44\u0E1B\u0E01\u0E34\u0E19\u0E02\u0E49\u0E32\u0E27\u0E42\u0E23\u0E07\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E01\u0E31\u0E19\u0E44\u0E2B\u0E21?"
  - "\u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E21\u0E35\u0E2A\u0E2D\u0E1A\u0E23\u0E36\u0E40\u0E1B\u0E25\u0E48\u0E32\u0E19\u0E30..."
  - "\u0E40\u0E25\u0E34\u0E01\u0E40\u0E23\u0E35\u0E22\u0E19\u0E41\u0E25\u0E49\u0E27\u0E44\u0E1B\u0E40\u0E25\u0E48\u0E19\u0E40\u0E01\u0E21\u0E01\u0E31\u0E19\u0E19\u0E30"
  satisfactionReward: 5
  rewardCooldown: 40
  greetRange: 4.5
  waveCooldown: 8
  idleActions:
  - Talking
  - Waving
  - Cheering
  isQuestGiver: 0
  questTargetDoor: 
  questText: "\u0E44\u0E1B\u0E17\u0E33\u0E20\u0E32\u0E23\u0E01\u0E34\u0E08\u0E17\u0E35\u0E48\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22"
  questGiveLine: "\u0E0A\u0E48\u0E27\u0E22\u0E44\u0E1B\u0E17\u0E33\u0E20\u0E32\u0E23\u0E01\u0E34\u0E08\u0E43\u0E2B\u0E49\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E2A\u0E34
    \u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E21\u0E35\u0E23\u0E32\u0E07\u0E27\u0E31\u0E25!"
