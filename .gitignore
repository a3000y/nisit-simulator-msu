*.slnx
.vs/
*.sln.DotSettings.user

# Profiler / memory captures and recordings made while testing
/[Pp]rofiler[Cc]aptures/
/[Rr]ecordings/
*.data.raw

# Logs and crash dumps produced while playing / building
*.log
*.dmp
crashlytics-build.properties

